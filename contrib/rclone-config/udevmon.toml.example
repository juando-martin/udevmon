# rclone-config: publish the rclone config of drives tagged "rclone".
# Copy to ~/.config/udevmon/config.d/rclone-config.toml (or merge into
# config.toml). `order` puts "up" before, and "down" after, the actions that
# use the credentials (they keep the default order, 50), whatever file they
# are in. The rclone-config command must be in a [daemon] script_dir folder,
# e.g. script_dir = ["~/.venvs/tools/bin"].

[[actions]]
name = "rclone-config-up"
tag = "rclone"
on = ["startup", "mounted"]
order = 10
run = ["rclone-config", "up", "{mountpoint}", "{drive_serial}:{fs_uuid}"]
lock = "rclone-config"
timeout = 30

[[actions]]
name = "rclone-config-down"
tag = "rclone"
on = ["unmounted", "shutdown"]
order = 90
run = ["rclone-config", "down", "{mountpoint}", "{drive_serial}:{fs_uuid}"]
lock = "rclone-config"
timeout = 30
